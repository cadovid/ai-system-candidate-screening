APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./var/screening.db
LLM_MODEL=openai:gpt-5.6-luna
OPENAI_API_KEY=
# Alternative provider. Select it with:
# LLM_MODEL=openrouter:deepseek/deepseek-v4-flash:free
OPENROUTER_API_KEY=
# Conservative routing defaults for candidate-data demos. The selected free
# route may be unavailable when these filters are applied; the app fails safe
# rather than silently routing to another model/provider.
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=800
INTERNAL_API_KEY=change-me-for-local-demo
SERVICE_AREAS_PATH=data/service_areas/service_areas.json
FAQ_PATH=data/faq/faq.json
INACTIVITY_HOURS=24
RETENTION_DAYS=90
