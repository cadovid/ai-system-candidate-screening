APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./var/screening.db
# Recommended free development provider.
LLM_MODEL=groq:openai/gpt-oss-20b
GROQ_API_KEY=
# Alternative valid Groq model (change the active selector above when used):
# LLM_MODEL=groq:openai/gpt-oss-120b
# Secondary free development provider. This pins the OpenRouter model ID;
# OpenRouter's serving endpoint/quantization can still change over time:
# LLM_MODEL=openrouter:z-ai/glm-5.2:free
OPENROUTER_API_KEY=
# Conservative routing defaults for candidate-data demos. The app never
# switches to another model/provider or paid route automatically.
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true
# The reviewed GLM route supports the full native strict JSON Schema request.
OPENROUTER_REQUIRE_PARAMETERS=true
# GLM-5.2 supports high (runtime default) and xhigh (manual evaluation only).
OPENROUTER_REASONING_EFFORT=high
# Dedicated OpenRouter transport timeout and bounded structured-output retry.
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_OUTPUT_RETRIES=1
# Usage-billed OpenAI route (explicit opt-in):
# LLM_MODEL=openai:gpt-5.6-luna
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
# Groq transient transport retries (0-2). The SDK honors Retry-After and uses
# jittered exponential backoff for 408/409/429/5xx responses.
GROQ_TRANSPORT_RETRIES=2
# Separate structured-output retry budget (0 or 1). LLM_MAX_RETRIES remains
# the global ceiling for output validation.
GROQ_OUTPUT_RETRIES=1
# Low, deterministic extraction sampling; summaries keep provider defaults.
LLM_EXTRACTION_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=800
# GPT-OSS only: low uses fewer hidden reasoning tokens; medium/high trade
# quota and latency for additional reasoning effort.
GROQ_REASONING_EFFORT=low
INTERNAL_API_KEY=change-me-for-local-demo
SERVICE_AREAS_PATH=data/service_areas/service_areas.json
FAQ_PATH=data/faq/faq.json
INACTIVITY_HOURS=24
RETENTION_DAYS=90
