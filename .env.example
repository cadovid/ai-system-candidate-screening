APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./var/screening.db
LLM_MODEL=openai:gpt-5.6-luna
OPENAI_API_KEY=
# Alternative provider. Select it with the requested model when the route is
# currently available:
# LLM_MODEL=openrouter:deepseek/deepseek-v4-flash:free
# Current zero-cost OpenRouter router (selects an available free model):
# LLM_MODEL=openrouter:openrouter/free
OPENROUTER_API_KEY=
# Conservative routing defaults for candidate-data demos. The app never
# switches to another paid model/provider automatically.
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true
# Strict parameter filtering can reject free endpoints that do not advertise
# every optional structured-tool parameter. Keep false for the free router;
# enable only after verifying the selected route supports the full request.
OPENROUTER_REQUIRE_PARAMETERS=false
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=800
INTERNAL_API_KEY=change-me-for-local-demo
SERVICE_AREAS_PATH=data/service_areas/service_areas.json
FAQ_PATH=data/faq/faq.json
INACTIVITY_HOURS=24
RETENTION_DAYS=90
