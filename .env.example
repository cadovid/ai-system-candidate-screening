APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./var/screening.db
# Recommended free development provider.
LLM_MODEL=groq:openai/gpt-oss-20b
GROQ_API_KEY=
# Alternative valid Groq model (change the active selector above when used):
# LLM_MODEL=groq:openai/gpt-oss-120b
# Secondary free development provider. The Free Models Router selects an
# available compatible free model and may route different requests to
# different models:
# LLM_MODEL=openrouter:openrouter/free
OPENROUTER_API_KEY=
# Conservative routing defaults for candidate-data demos. The app never
# switches to another paid model/provider automatically.
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true
# Strict parameter filtering can reject free endpoints that do not advertise
# every optional structured-tool parameter. Keep false for the free router;
# enable only after verifying the selected route supports the full request.
OPENROUTER_REQUIRE_PARAMETERS=false
# Usage-billed OpenAI route (explicit opt-in):
# LLM_MODEL=openai:gpt-5.6-luna
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
# Groq structured-output retry budget (0 or 1); Groq SDK transport retries
# remain disabled. LLM_MAX_RETRIES is still the global ceiling.
GROQ_OUTPUT_RETRIES=1
# Low, deterministic extraction sampling; summaries keep provider defaults.
LLM_EXTRACTION_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=800
# GPT-OSS only: low uses fewer hidden reasoning tokens; medium/high trade
# quota and latency for additional reasoning effort.
GROQ_REASONING_EFFORT=low
INTERNAL_API_KEY=change-me-for-local-demo
SERVICE_AREAS_PATH=data/service_areas/service_areas.json
FAQ_PATH=data/faq/faq.json
INACTIVITY_HOURS=24
RETENTION_DAYS=90
